# Copy to .env (ignored by git) and replace every <YOUR_...> value with a new random secret.
# Never reuse a value that was ever committed to this public repository: the API refuses known
# published JWT keys and admin passwords at startup (src/SupplyGuard.Infrastructure/Security/PublicSecrets.cs).
#
# Generate a value in PowerShell (48 random bytes, URL-safe; works in Windows PowerShell 5.1 and PowerShell 7):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')

POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=supplyguard_db
RABBITMQ_USER=supplyguard
RABBITMQ_PASSWORD=<YOUR_RABBITMQ_PASSWORD>
RABBITMQ_VHOST=supplyguard

# Required for the Dockerized API. Keep actual values only in the ignored .env file.
JWT_ISSUER=SupplyGuard.WebAPI
JWT_AUDIENCE=SupplyGuard.Client
# At least 32 bytes; anyone who knows this key can forge administrator tokens.
JWT_SIGNING_KEY=<YOUR_JWT_SIGNING_KEY>
INITIAL_ADMIN_USERNAME=administrator
INITIAL_ADMIN_EMAIL=admin@supplyguard.local
# At least 12 characters with upper/lower case, a digit and a symbol. Only used when the admin is first created.
INITIAL_ADMIN_PASSWORD=<YOUR_INITIAL_ADMIN_PASSWORD>
API_PORT=8080
