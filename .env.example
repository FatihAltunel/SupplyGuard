POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=supplyguard_password
POSTGRES_DB=supplyguard_db
RABBITMQ_USER=supplyguard
RABBITMQ_PASSWORD=<YOUR_RABBITMQ_PASSWORD>
RABBITMQ_VHOST=supplyguard

# Required for the Dockerized API. Keep actual values only in the ignored .env file.
JWT_ISSUER=SupplyGuard.WebAPI
JWT_AUDIENCE=SupplyGuard.Client
JWT_SIGNING_KEY=SuperSecretKeyForSupplyGuard_2026_TestEnvironment!
INITIAL_ADMIN_USERNAME=administrator
INITIAL_ADMIN_EMAIL=admin@supplyguard.local
INITIAL_ADMIN_PASSWORD=SupplyGuard_Admin2026!
API_PORT=8080
