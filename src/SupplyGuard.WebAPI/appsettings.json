{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "supplyguard",
    "UserName": "supplyguard",
    "Password": "<YOUR_RABBITMQ_PASSWORD>",
    "UseTls": false,
    "ClientProvidedName": "SupplyGuard.OutboxPublisher",
    "ExchangeName": "supplyguard.events",
    "NotificationQueueName": "notification.queue",
    "NotificationErrorExchangeName": "supplyguard.notification.errors",
    "NotificationErrorQueueName": "notification.error.queue",
    "ConsumerPrefetchCount": 10,
    "ConsumerReconnectDelay": "00:00:05",
    "ConnectionTimeout": "00:00:10",
    "OperationTimeout": "00:00:10",
    "PublishTimeout": "00:00:30"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "PublishTimeout": "00:00:30",
    "RetryDelay": "00:00:30",
    "MaxRetryDelay": "00:05:00"
  }
}
