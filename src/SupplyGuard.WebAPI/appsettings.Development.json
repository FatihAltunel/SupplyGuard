{
  "ConnectionStrings": {
    "SupplyGuardDatabase": "Host=localhost;Port=5432;Database=supplyguard_db;Username=supplyguard;Password=<YOUR_DB_PASSWORD>",
    "Redis": "<YOUR_REDIS_CONNECTION_STRING>"
  },
  "Jwt": {
    "Issuer": "SupplyGuard.WebAPI",
    "Audience": "SupplyGuard.Client",
    "SigningKey": "<YOUR_SUPER_SECRET_DUMMY_KEY_MIN_256_BIT>",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Identity": {
    "InitialAdministrator": {
      "UserName": "administrator",
      "Email": "admin@supplyguard.local",
      "Password": "<YOUR_INITIAL_ADMIN_PASSWORD>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
