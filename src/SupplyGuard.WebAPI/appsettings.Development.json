{
  "ConnectionStrings": {
    "SupplyGuardDatabase": "Host=postgres;Port=5432;Database=supplyguard_db;Username=supplyguard;Password=<YOUR_DB_PASSWORD>",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "SupplyGuard.WebAPI",
    "Audience": "SupplyGuard.Client",
    "SigningKey": "<YOUR_JWT_SIGNING_KEY>",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Identity": {
    "InitialAdministrator": {
      "UserName": "administrator",
      "Email": "admin@supplyguard.local",
      "Password": "<YOUR_INITIAL_ADMIN_PASSWORD>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
