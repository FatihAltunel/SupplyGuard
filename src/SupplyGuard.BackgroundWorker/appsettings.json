{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "Outbox": { "RetryUseJitter": true },
  "RabbitMq": {
    "ClientProvidedName": "SupplyGuard.BackgroundWorker",
    "WorkerRequestQueueName": "supplyguard.risk.requests",
    "WorkerResponseQueueName": "supplyguard.risk.responses",
    "WorkerResponseErrorQueueName": "supplyguard.risk.responses.error",
    "ConsumerPrefetchCount": 1,
    "ConnectionRetryCount": 3,
    "ConnectionRetryDelay": "00:00:02",
    "ConnectionRetryMaxDelay": "00:00:30",
    "ConnectionRetryUseJitter": false
  }
}
